# Zunesty Tools — environment variables
# Copy to .env.local and fill in. Set the same values in Vercel for production.

# ─── Anthropic / Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Notion (Growth Plan tool) ──────────────────────────────────────────────
NOTION_API_KEY=

# ─── Gamma (Client Reporting tool) ──────────────────────────────────────────
GAMMA_API_KEY=

# ─── Slack (Client Pipeline notifications) ──────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Google Drive (Ad Generator) ────────────────────────────────────────────
# Required. OAuth refresh-token mode — full read + write access under the
# Google account that consented to the OAuth flow.
#
# Setup:
#   1. Google Cloud Console → OAuth consent screen → Internal (Workspace)
#   2. Credentials → Create OAuth client ID → Web application
#        Authorized redirect URI: http://localhost:4567/oauth-callback
#   3. Mint the refresh token locally:
#        GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... \
#          node scripts/get-google-refresh-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Drive folder IDs (get from the URL: drive.google.com/drive/folders/<ID>)
DRIVE_BOTTLES_FOLDER_ID=
DRIVE_OUTPUT_FOLDER_ID=
DRIVE_APPROVED_FOLDER_ID=

# ─── Fallback: API-key mode (read-only public files) ────────────────────────
# Only needed if you flip google-drive.ts back to the commented API-key block.
# GOOGLE_API_KEY=

# ─── KIE AI (Ad Generator image-to-image) ───────────────────────────────────
KIE_AI_API_KEY=

# ─── Triple Whale (Ad Generator winner discovery) ───────────────────────────
# Optional. If both vars are set, the /winners endpoint pulls real top
# performers via a SQL query against the ads_table; otherwise it falls
# back to the built-in mock seeds so the pipeline still works.
#
# How to get them:
#   1. Triple Whale → Data → APIs → Generate
#      Scopes needed: Pixel Attribution: Read, Summary Page: Read
#   2. The shop ID is the same one you see in the Triple Whale dashboard URL
#      (and in the API key generation flow)
TRIPLE_WHALE_API_KEY=
TRIPLE_WHALE_SHOP_ID=

# ─── Follow-Up Agent (Fathom + Gmail → draft follow-ups) ────────────────────
# ENCRYPTION_KEY encrypts Fathom keys, Gmail tokens, and webhook secrets at
# rest in Supabase (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Separate OAuth client from the Google Drive one above — this one requests
# gmail.compose only (drafts, never sends) via a live per-user OAuth flow.
#   1. Google Cloud Console → APIs & Services → Library → Gmail API → Enable
#   2. OAuth consent screen → External, Testing is fine → add each Gmail
#      address that will connect as a Test user
#   3. Credentials → Create OAuth client ID → Web application
#        Authorized redirect URI: <FOLLOWUP_PUBLIC_BASE_URL>/api/follow-up-agent/oauth/callback
FOLLOWUP_GOOGLE_CLIENT_ID=
FOLLOWUP_GOOGLE_CLIENT_SECRET=

# No trailing slash. Drives the OAuth redirect + the Fathom webhook
# destination URL. Dev: http://localhost:3000. Prod: the deployed domain.
FOLLOWUP_PUBLIC_BASE_URL=http://localhost:3000

# Protects GET /api/follow-up-agent/poll (the hourly Autopilot safety-net
# sweep); Vercel Cron sends this as a Bearer token automatically.
CRON_SECRET=

# Optional. Defaults to claude-sonnet-4-5 if unset. Uses the shared
# ANTHROPIC_API_KEY above — no per-profile Claude key.
ANTHROPIC_MODEL=

# Fathom keys, Gmail tokens, and the Fathom webhook secret are profile-scoped
# and stored encrypted in Supabase (followup_profiles table) — never env vars.

