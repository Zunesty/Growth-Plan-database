# Zunesty Tools — environment variables
# Copy to .env.local and fill in. Set the same values in Vercel for production.

# ─── Anthropic / Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Notion (Growth Plan tool) ──────────────────────────────────────────────
NOTION_API_KEY=

# ─── Gamma (Client Reporting tool) ──────────────────────────────────────────
GAMMA_API_KEY=

# ─── Slack (Client Pipeline notifications) ──────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Google Drive (Ad Generator) ────────────────────────────────────────────
# Required. API key auth — works for READING public files only.
#   1. Google Cloud Console → APIs & Services → Credentials → Create API key
#   2. Restrict the key to "Google Drive API"
#   3. Paste here
# IMPORTANT: every Drive folder/file the app reads must be set to
# "Anyone with the link can view". API keys cannot access private files.
GOOGLE_API_KEY=

# Drive folder IDs (get from the URL: drive.google.com/drive/folders/<ID>)
DRIVE_BOTTLES_FOLDER_ID=
DRIVE_OUTPUT_FOLDER_ID=
DRIVE_APPROVED_FOLDER_ID=

# ─── Future: OAuth (for private files + Drive writes) ───────────────────────
# When we need to upload to Drive or read private folders, switch back to OAuth.
# The refresh token helper script is at scripts/get-google-refresh-token.mjs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ─── KIE AI (Ad Generator image-to-image) ───────────────────────────────────
KIE_AI_API_KEY=
